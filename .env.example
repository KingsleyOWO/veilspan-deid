# 模型端點（OpenAI 相容 API）。金鑰只放在 .env，不要進版本庫。
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=your-model-name
LLM_API_KEY=
# 預設只接受來自本機的連線。自行部署到內網時，請同時調整這兩項。
HOST=127.0.0.1
ALLOWED_CLIENTS=127.0.0.1
# 以下為預設值，需要時再改
# LLM_CONCURRENCY=6
# LLM_THINKING=false
# PORT=8620
# DATA_DIR=data
# MAX_UPLOAD_MB=200
# DELETE_AFTER_DOWNLOAD_MIN=30
# JOB_TTL_HOURS=24
# 一份文件最多處理幾分鐘，0 表示不限。
# JOB_TIMEOUT_MIN=180
# FACE_DEFAULT_ON=true
# FACE_SCORE=0.7
# FACE_MODEL=models/yunet.onnx
# MASK_FULL=■
# MASK_HALF=*
# OCR_WORKERS=4
# AGENT_MAX_STEPS=60
# AGENT_EXTRA_STEPS=20
# USE_AGENT=true
# SANDBOX_IMAGE=deid-sandbox:1
# PDF 影像解析度，供預覽、OCR 和遮蔽使用。
# PDF_DPI=200
# 邊長低於這個像素數的圖片會跳過模型判斷。
# MIN_VISION_PX=48
# 第一輪文字偵測的每段字數。
# CHUNK_CHARS=2500
# 第二輪文字偵測的每段字數，0 表示停用第二輪。
# RECHECK_CHUNK_CHARS=1200
# 代號＋還原：偵測後由模型判斷哪些姓名是同一個人（同一人用同一個號碼的代號）
# LINK_NAMES=true
# LINK_MAX_STEPS=30
